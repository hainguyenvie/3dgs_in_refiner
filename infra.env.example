# Cluster identity — the only file that knows which machine this project runs on.
# cp infra.env.example infra.env && $EDITOR infra.env   (infra.env is gitignored)
RIT_SSH=            # ssh alias from the operator's ~/.ssh/config (ProxyJump inside it)
RIT_REMOTE_ROOT=    # absolute project root on the server (= ~/projects/3dgs-refiner-it)
RIT_CARDS=0,1,2,3,4,5,6,7   # cards this project may use (still: only enter cards at 0 MiB)
